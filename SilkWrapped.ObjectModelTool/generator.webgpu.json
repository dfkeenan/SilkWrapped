{
  "ProjectFilePath": "..\\SilkWrapped.WebGPU\\SilkWrapped.WebGPU.csproj",
  "ApiTypeName": "Silk.NET.WebGPU.WebGPU",
  "ApiOwnerTypeName": "Silk.NET.WebGPU.Instance",
  "ConstructionMethodNamePattern": ".*(Create|Finish|Acquire).*",
  "DisposalMethodNamePattern": ".*(Release).*",
  "HandleTypeNameExclusionPattern": "(Pfn).*|.*Descriptor|InstanceFeatures|Future|SurfaceCapabilities",

  "ObjectModelNameFormatString": "{0}Wrapper",
  "OutputPath": "Generated\\",

  "TransformGenerators": [
    {
      "$type": "ExtractObjectModelTypes",
      "Rewriters": [
        {
          "$type": "RemoveAttributes",
          "Names": [ "NativeName", "NativeApi", "Flow", "RequiresLocation", "UnmanagedType" ]
        },
        {
          "$type": "RemoveMethods",
          "Names": [ "GetProcAddress", "DeviceCreateShaderModule" ]
        }
      ]
    },
    {
      "$type": "ExtractTypes",
      "TypeKind": "Enum",
      "OutputPath": "Generated\\Enums",
      "Rewriters": [
        {
          "$type": "RemoveAttributes",
          "Names": [ "NativeName" ]
        }
      ]
    },
    {
      "$type": "ExtractTypes",
      "TypeKind": "Struct",
      "ExcludeTypesPattern": "Pfn.*|ShaderModule.*|ChainedStruct.*",
      "OutputPath": "Generated\\Structs",
      "Rewriters": [
        {
          "$type": "RemoveAttributes",
          "Names": [ "NativeName" ]
        },
        {
          "$type": "BytePointerToString",
          "Names": [ "Label", "Key" ]
        },
        {
          "$type": "RemoveChainingStruct"
        },
        {
          "$type": "ObjectModelTypeReplacer"
        },
        {
          "$type": "PointerToSpan"
        },
        {
          "$type": "MakeStructPartial"
        },
        {
          "$type": "PointerToNullableType"
        }
      ]
    },
    {
      "$type": "ExtractTypes",
      "TypeKind": "Delegate",
      "ExcludeTypesPattern": "Proc",
      "OutputPath": "Generated\\Delegates",
      "Rewriters": [
        {
          "$type": "RemoveAttributes",
          "Names": [ "UnmanagedFunctionPointer" ]
        },
        {
          "$type": "ObjectModelTypeReplacer"
        },
        {
          "$type": "BytePointerToString"
        }
      ]
    },
    {
      "$type": "ExtractTypes",
      "TypeKind": "Struct",
      "IncludeTypesPattern": "Pfn.*",
      "ExcludeTypesPattern": "PfnProc",
      "OutputPath": "Generated\\Delegates",
      "SkipMarhsalling": true,
      "Rewriters": [
        {
          "$type": "ImplementFunctionPointer"
        }
      ]
    },
    //{
    //  "$type": "FixRefStructs"
    //},
    {
      "$type": "ImplementObjectModelTypes",
      "Rewriters": [
        {
          "$type": "RemoveAttributes",
          "Names": [ "NativeName", "NativeApi", "Flow", "RequiresLocation", "UnmanagedType" ]
        },
        {
          "$type": "RemoveMethods",
          "Names": [ "GetProcAddress", "DeviceCreateShaderModule", "TryGetDeviceExtension", "IsDeviceExtensionPresent" ]
        },
        {
          "$type": "AddObjectModelHandle"
        },
        {
          "$type": "AddObjectModelApi"
        },
        {
          "$type": "AddObjectModelConstructor"
        },
        {
          "$type": "ImplemementApiMethod"
        },
        {
          "$type": "SimplifyMethodSignature"
        },
        {
          "$type": "ObjectModelTypeReplacer",
          "SkipConstructor": true
        },
        {
          "$type": "PointerToSpan"
        },
        {
          "$type": "ReplaceParameterWithExpression",
          "Parameters": {
            "void* userdata": "null"
          }
        },
        {
          "$type": "RemoveMethodOverloads"
        },
        {
          "$type": "ChangeHandleToObjectModel"
        },
        {
          "$type": "AddObjectModelDispose"
        }
      ]
    }
  ]
}